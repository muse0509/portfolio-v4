{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-v4-api",
  "main": "src/index.ts",
  // Match the newest date supported by the existing pinned workerd runtime.
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-v4-local",
      // Local-only placeholder; no remote database has been provisioned.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "remote": false
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
