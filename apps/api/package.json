{
  "name": "@portfolio-v4/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.22.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "cf-typegen": "wrangler types --env-interface ApiEnv cloudflare-env.d.ts",
    "typecheck": "wrangler types --env-interface ApiEnv cloudflare-env.d.ts --check && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "auth:setup:local": "node scripts/local-auth.ts setup",
    "auth:issue:local": "node scripts/local-auth.ts issue",
    "auth:schema:generate": "auth generate --config ./auth.schema.config.ts --adapter drizzle --dialect sqlite --output ./src/auth/schema.ts --yes",
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@better-auth/passkey": "1.7.14",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14"
  },
  "devDependencies": {
    "auth": "1.7.12",
    "drizzle-kit": "0.31.11",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.0"
  }
}
