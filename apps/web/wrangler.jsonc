{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-v4",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "API",
      "service": "portfolio-v4-api",
      "remote": false
    }
  ],
  "observability": {
    "enabled": true
  }
}
