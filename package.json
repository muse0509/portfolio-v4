{
  "name": "portfolio-v4",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "dev": "pnpm --filter @portfolio-v4/web dev",
    "dev:api": "pnpm --filter @portfolio-v4/api dev",
    "dev:worker": "pnpm --filter @portfolio-v4/web dev:worker",
    "build": "pnpm --filter @portfolio-v4/web build",
    "build:worker": "pnpm --filter @portfolio-v4/web build:worker",
    "build:api": "pnpm --filter @portfolio-v4/api build",
    "start": "pnpm --filter @portfolio-v4/web start",
    "typegen": "pnpm --filter @portfolio-v4/web typegen",
    "test": "pnpm --filter @portfolio-v4/web test",
    "test:api": "pnpm --filter @portfolio-v4/api test",
    "test:integration": "pnpm --filter @portfolio-v4/web test:integration",
    "preview": "pnpm --filter @portfolio-v4/web preview",
    "deploy": "pnpm --filter @portfolio-v4/web deploy",
    "cf-typegen": "pnpm --filter @portfolio-v4/web cf-typegen",
    "cf-typegen:api": "pnpm --filter @portfolio-v4/api cf-typegen",
    "lint": "pnpm lint:web && pnpm lint:api && pnpm lint:e2e",
    "lint:web": "pnpm --filter @portfolio-v4/web lint",
    "lint:api": "pnpm --filter @portfolio-v4/api lint",
    "lint:e2e": "eslint .",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:api && pnpm typecheck:e2e",
    "typecheck:web": "pnpm --filter @portfolio-v4/web typecheck",
    "typecheck:api": "pnpm --filter @portfolio-v4/api typecheck",
    "typecheck:e2e": "tsc --noEmit",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:api && pnpm build:api && pnpm build:worker && pnpm test:integration"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "10.13.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.22.0"
}
